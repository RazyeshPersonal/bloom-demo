# Your Flawsnap project key (Portal → Project → Install). Leave empty to run
# the shop without the widget, e.g. for the "staging" copy used with the
# Chrome extension.
VITE_FLAWSNAP_KEY=

# Optional: a banner at the top, e.g. "Staging". Empty = no banner.
VITE_ENV_LABEL=

# Optional, only for a self-hosted or local Flawsnap:
# VITE_FLAWSNAP_SRC=http://localhost:8080/widget.js
# VITE_FLAWSNAP_API=http://localhost:8080/api/v1
