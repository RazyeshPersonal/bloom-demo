{
  "name": "bloom-demo",
  "private": true,
  "version": "1.0.0",
  "description": "Bloom & Co: a tiny demo plant shop used in Flawsnap tutorials",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c green,cyan \"node --watch server/index.js\" \"vite\"",
