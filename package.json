    "web": "vite",
    "build": "vite build",
    "test": "vitest run"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "supertest": "^7.0.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
